# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/rapidroute

# JWT (change in production)
JWT_SECRET=change_me_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# OSRM — local Docker or public demo endpoint
OSRM_BASE_URL=https://router.project-osrm.org

# ML service
ML_SERVICE_URL=http://localhost:8000

# Weather (optional — leave empty for graceful fallback)
OPENWEATHER_API_KEY=

# Tracking simulation
TRACKING_SIMULATION_ENABLED=true
TRACKING_TICK_MS=2000
