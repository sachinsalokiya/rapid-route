# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# On Render, CLIENT_URL can be your public https://....onrender.com URL
# (RENDER_EXTERNAL_URL is also used automatically when set by Render)
SERVE_FRONTEND=false

# MongoDB
MONGODB_URI=mongodb://localhost:27017/rapidroute

# JWT (change in production)
JWT_SECRET=change_me_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# OSRM — local Docker or public demo endpoint
OSRM_BASE_URL=https://router.project-osrm.org

# ML service (leave empty to use the labeled heuristic fallback)
ML_SERVICE_URL=http://localhost:8000

# Seed demo users and shipments when the database has no users
SEED_ON_EMPTY=true

# Weather (optional — leave empty for graceful fallback)
OPENWEATHER_API_KEY=

# Tracking simulation
TRACKING_SIMULATION_ENABLED=true
TRACKING_TICK_MS=2000
