{
  "name": "rapid-route-backend",
  "version": "1.0.0",
  "description": "Rapid Route logistics API — Express + MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand --forceExit",
    "lint": "eslint . --ext .js --ignore-pattern coverage --ignore-pattern node_modules"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["logistics", "routing", "express", "mongodb"],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.3",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.1",
    "validator": "^13.12.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 180000,
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"]
  }
}
